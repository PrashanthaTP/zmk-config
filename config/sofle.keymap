#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // -------------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2      |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9      |   0   | BKSPC |
            // |  TAB  |  Q  |  W      |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O      |   P   |   -   |
            // | SHIFT |  A  |  S      |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L      |   ;   |   '   |
            // | CTRL  |  Z  |  X      |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .      |   /   | SHIFT |
            //               | LT4 GUI | ALT  | CTRL | LOWER|  SPACE |  | ENTER | RAISE| RCTRL | RALT  | LT4 GUI |

            bindings = <
&kp GRAVE         &kp N1  &kp N2          &kp N3    &kp N4     &kp N5                              &kp N6     &kp N7     &kp N8     &kp N9           &kp N0    &kp BACKSPACE
&kp TAB           &kp Q   &kp W           &kp E     &kp R      &kp T                               &kp Y      &kp U      &kp I      &kp O            &kp P     &kp MINUS
&kp LEFT_SHIFT    &kp A   &kp S           &kp D     &kp F      &kp G                               &kp H      &kp J      &kp K      &kp L            &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X           &kp C     &kp V      &kp B      &kp C_MUTE    &none      &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH  &kp RSHFT
                          &lt 4 LEFT_GUI  &kp LALT  &kp LCTRL  &mo LOWER  &kp SPACE     &kp ENTER  &mo RAISE  &kp RCTRL  &kp RALT   &lt 4 RIGHT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  (  |  )  |  [   |  ]   |  %   |                   |  ^   |  {    |  }    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  /   |  \    |  ;    |  :   |   \   |  DEL  |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans     &kp F1                &kp F2                 &kp F3            &kp F4             &kp F5                       &kp F6     &kp F7          &kp F8           &kp F9     &kp F10   &kp F11
&kp GRAVE  &kp N1                &kp N2                 &kp N3            &kp N4             &kp N5                       &kp N6     &kp N7          &kp N8           &kp N9     &kp N0    &kp F12
&trans     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PRCNT                    &kp CARET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LPAR   &kp RPAR  &kp PIPE
&trans     &kp EQUAL             &kp MINUS              &kp PLUS          &kp LBRC           &kp RBRC   &trans    &trans  &kp SLASH  &kp BACKSLASH   &kp SEMI         &kp COLON  &kp BSLH  &kp DELETE
                                 &trans                 &trans            &trans             &trans     &trans    &trans  &trans     &trans          &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS | PSCR| MENU  |       |      |                |  %   |  ^   |   &   |  *   |       |       |
            // |       |  !  |  @  |   #   |   $   | CAPS |                | LEFT | DOWN |   ^   | RIGHT|       | PG_UP |
            // |       | HOME| CUT | COPY  | PASTE | END  |      |  |      |      |      |       |      |       | PG_DN |
            //               |     |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans       &trans     &trans         &trans     &trans  &trans
&trans      &kp INS          &kp PSCRN     &kp K_CMENU   &trans        &trans                          &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp STAR   &none   &none
&trans      &kp EXCLAMATION  &kp AT        &kp POUND     &kp DOLLAR    &kp CLCK                        &kp LEFT     &kp DOWN   &kp UP_ARROW   &kp RIGHT  &none   &kp PAGE_UP
&trans      &kp HOME         &kp K_CUT     &kp K_COPY    &kp K_PASTE   &kp END       &trans    &trans  &trans       &trans     &trans         &trans     &trans  &kp PAGE_DOWN
                             &trans        &trans        &trans        &trans        &trans    &trans  &trans       &trans     &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none              &none  &none  &none  &none  &none
            >;
        };

maths_layer {
            display-name = "maths";

            // ------------------------------------------------------------------------------------------------------------
            // | BOOTLD |  &  |  ^  |  $  |  !  |  =  |                |  =  |  !  |   $   |  ^  |   &   | BOOTLD|
            // |  TRANS |  &  |  ^  |  $  |  !  |  =  |                |  =  |  !  |   $   |  ^  |   &   | TRANS |
            // |  TRANS |  -  |  +  |  *  |  /  |  ?  |                |  ?  |  /  |   *   |  +  |   -   | TRANS |
            // |  TRANS |TRANS|TRANS|TRANS|TRANS|  #  | TRANS |  TRANS |  #  | NONE|  NONE | NONE|  NONE | TRANS |
            //                |TRANS|TRANS|TRANS|TRANS| TRANS |  TRANS |TRANS|TRANS| TRANS |TRANS|

            bindings = <
&bootloader  &trans         &trans     &trans      &trans           &trans                          &trans        &trans           &trans      &trans     &trans         &bootloader
&trans       &kp AMPERSAND  &kp CARET  &kp DOLLAR  &kp EXCLAMATION  &kp EQUAL                       &kp EQUAL     &kp EXCLAMATION  &kp DOLLAR  &kp CARET  &kp AMPERSAND  &trans
&trans       &kp MINUS      &kp PLUS   &kp STAR    &kp SLASH        &kp QUESTION                    &kp QUESTION  &kp SLASH        &kp STAR    &kp PLUS   &kp MINUS      &trans
&trans       &trans         &trans     &trans      &trans           &kp HASH      &trans    &trans  &kp HASH      &none            &none       &none      &none          &trans
                            &trans     &trans      &trans           &trans        &trans    &trans  &trans        &trans           &trans      &trans
            >;
        };
    };
};
